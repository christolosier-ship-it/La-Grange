{
  "name": "la-grange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run src/app/router.integration.test.ts",
    "smoke:github": "vitest run src/core/github/live-smoke.test.ts --environment node"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/node": "24.0.10",
    "eslint": "9.30.1",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "7.0.4",
    "vitest": "3.2.4"
  }
}
